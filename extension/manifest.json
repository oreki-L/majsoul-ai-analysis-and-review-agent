{
  "manifest_version": 3,
  "name": "Majsoul Agent",
  "version": "0.8.1",
  "description": "雀魂 AI 牌局分析与复盘助手，支持自接模型 API、可选日麻引擎和独立牌局获取器。",
  "web_accessible_resources": [
    {
      "resources": [
        "tiles/*.svg",
        "analysis-panel.css",
        "naga-panel.css"
      ],
      "matches": [
        "https://game.maj-soul.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://game.maj-soul.com/*"
      ],
      "js": [
        "protocol.js",
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://game.maj-soul.com/*"
      ],
      "js": [
        "state.js",
        "history.js",
        "collector/controller.js",
        "collector/browser-adapter.js",
        "contracts/snapshot.js",
        "collector/snapshot-adapter.js",
        "adapters/mjai.js",
        "adapters/naga-replay.js",
        "mahjong-analysis.js",
        "analysis.js",
        "postgame-review.js",
        "analysis-panel.js",
        "panel-theme.js",
        "overlay.js",
        "floating-panel.js",
        "hand-hints.js",
        "naga-panel.js",
        "user-memory-capture.js",
        "apps/agent-app.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
